{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlgortimoTD/molt-security-advisories/schema/advisory.schema.json",
  "title": "Molt security advisory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "summary", "status", "published", "updated", "severity", "affected", "exposure", "detectors", "remediation", "verification", "sources", "review", "history"],
  "properties": {
    "schema": { "const": "msa/1" },
    "id": { "type": "string", "pattern": "^MSA-[0-9]{4}-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 10, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 40, "maxLength": 1500 },
    "status": { "enum": ["published", "withdrawn"] },
    "withdrawn_reason": { "type": "string" },
    "published": { "$ref": "#/$defs/date" },
    "updated": { "$ref": "#/$defs/date" },
    "cve": { "type": "array", "items": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" }, "uniqueItems": true },
    "ghsa": { "type": "array", "items": { "type": "string", "pattern": "^GHSA(-[23456789cfghjmpqrvwx]{4}){3}$" }, "uniqueItems": true },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "urgency", "rationale"],
      "properties": {
        "level": { "enum": ["critical", "high", "medium", "low", "informational"] },
        "urgency": { "enum": ["24h", "72h", "30d", "next-update"] },
        "rationale": { "type": "string", "minLength": 40 }
      }
    },
    "vendor_severity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "value"],
        "properties": {
          "source": { "type": "string" },
          "value": { "type": "string" },
          "vector": { "type": "string" },
          "applies_to": { "type": "string" }
        }
      }
    },
    "exploitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["none-known", "public-exploit", "exploited-in-the-wild"] },
        "kev": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "affected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product"],
        "properties": {
          "product": { "type": "string" },
          "ecosystem": { "type": "string" },
          "introduced": { "type": "string" },
          "fixed": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "exposure": { "type": "string", "minLength": 40 },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "params"],
        "properties": {
          "type": { "enum": ["chromium-browser-version", "running-process-flag", "executable-version", "package-version", "manual"] },
          "params": { "type": "object" },
          "context": { "enum": ["browsing", "test-only", "any"] },
          "note": { "type": "string" }
        }
      }
    },
    "remediation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "details", "risk"],
        "properties": {
          "action": { "type": "string" },
          "details": { "type": "string" },
          "risk": { "type": "string" },
          "applies_to": { "type": "string" }
        }
      }
    },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "publisher", "tier", "retrieved", "supports"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "publisher": { "type": "string" },
          "tier": { "enum": [1, 2] },
          "retrieved": { "$ref": "#/$defs/date" },
          "supports": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "quote": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "discovery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "kind"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "kind": { "enum": ["social", "news", "blog", "forum", "feed", "forwarded"] },
          "seen": { "$ref": "#/$defs/date" },
          "note": { "type": "string" }
        }
      }
    },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^MS[AR]-[0-9]{4}-[0-9]{4}$" } },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_model", "reviewer_model", "reviewed", "verdict"],
      "properties": {
        "author_model": { "type": "string" },
        "reviewer_model": { "type": "string" },
        "reviewed": { "$ref": "#/$defs/date" },
        "verdict": { "enum": ["approve"] },
        "notes": { "type": "string" }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "change"],
        "properties": { "date": { "$ref": "#/$defs/date" }, "change": { "type": "string" } }
      }
    }
  },
  "$defs": { "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } }
}
