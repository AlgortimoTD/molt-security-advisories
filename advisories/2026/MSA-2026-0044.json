  "remediation": [
    {
      "action": "Apply the verified fix",
      "details": "Update v1 Inspector and affected split packages to 1.0.3 or later on that line. Update v2 Inspector to 2.12.0 or later for the Windows/WSL flaw. Restart the proxy and UI.",
      "risk": "Medium. Restart affected sessions and validate dependent workflows."
    }
  ],
