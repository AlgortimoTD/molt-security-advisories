{
  "schema": "msa/1",
  "id": "MSA-2026-0044",
  "title": "MCP Inspector remote server content can trigger local command execution",
  "summary": "Two v1 flaws allow a malicious server's OAuth callback or MCP App to invoke local commands through Inspector. A separate v2 flaw executes a server-supplied OAuth URL through PowerShell on Windows and WSL. Fixes differ by release line.",
  "status": "published",
  "published": "2026-11-07",
  "updated": "2026-11-07",
  "severity": {
    "level": "high",
    "urgency": "72h",
    "rationale": "Connecting to an attacker-controlled MCP server is required. Testing unfamiliar servers is a common developer workflow, making these local execution paths high priority even though the vendor rates the v1 flaws Critical."
  },
  "affected": [
    {
      "product": "@modelcontextprotocol/inspector",
      "ecosystem": "npm",
      "introduced": "0.13.0",
      "fixed": "1.0.3",
      "note": "OAuth callback flaw; MCP App token-theft flaw starts at 0.20.0."
    },
    {
      "product": "@modelcontextprotocol/inspector-client",
      "ecosystem": "npm",
      "introduced": "0.13.0",
      "fixed": "1.0.3",
      "note": "OAuth callback flaw; MCP App flaw starts at 0.20.0."
    },
    {
      "product": "@modelcontextprotocol/inspector-server",
      "ecosystem": "npm",
      "introduced": "0.20.0",
      "fixed": "1.0.3",
      "note": "MCP App token-theft flaw."
    },
    {
      "product": "@modelcontextprotocol/inspector",
      "ecosystem": "npm",
      "introduced": "2.0.0",
      "fixed": "2.12.0",
      "note": "OAuth URL PowerShell injection on Windows and WSL, through 2.11.0."
    }
  ],
  "exposure": "Requires connecting to a malicious remote server and entering its OAuth flow or viewing its MCP App. The v2 PowerShell issue affects Windows and WSL; it triggers during connection without tool approval.",
