  "remediation": [
    {
      "action": "Update or contain the affected component",
      "details": "Update Aspire CLI to 13.6.5 or later through its installation method. Update npm platform dependencies as well. Updating the .NET runtime or SDK alone does not update Aspire.",
      "risk": "Medium. Updating and restarting can interrupt dependent workflows."
    }
