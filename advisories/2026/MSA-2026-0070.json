  "schema": "msa/1",
  "id": "MSA-2026-0070",
  "title": "Aspire CLI temporary files expose configuration and permit local build code execution",
  "summary": "Insecure temporary-directory handling lets a local attacker influence generated MSBuild builds. The deprecated MCP scanner can also disclose sensitive configuration through temporary diagnostic files.",
  "status": "published",
  "published": "2026-11-12",
  "updated": "2026-11-12",
  "severity": {
    "level": "medium",
    "urgency": "30d",
    "rationale": "Both paths require local access on non-Windows systems. Shared temporary directories and CLI operations are prerequisites, warranting action within 30 days under the local-access rubric."
  },
