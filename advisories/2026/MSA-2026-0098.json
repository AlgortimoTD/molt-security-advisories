  ],
  "severity": {
    "level": "medium",
    "urgency": "30d",
    "rationale": "Untrusted peers can exhaust a client or server worker, and the pure-Python parser can process requests more than once. These conditions warrant a 30-day response for affected HTTP integrations; no code execution is established."
  },
  "vendor_severity": [
    {
      "source": "GitHub Reviewed Advisory Database",
      "value": "High for each of the eight advisories"
    }
  ],
  "affected": [
    {
      "product": "aiohttp",
      "ecosystem": "PyPI",
      "fixed": "3.14.4",
      "note": "All eight reviewed advisories list versions through 3.14.3 as affected."
    }
  ],
  "exposure": "HTTP integrations processing untrusted peers are exposed according to the feature used. Compressed payload and WebSocket queue issues affect clients as well as servers. Request replay needs the pure-Python parser; integer overflow affects the C WebSocket reader. Other server triggers require delayed upgrade handling, multipart reads, Request.post(), or a domain mask with multiple wildcards.",
  "detectors": [
    {
      "type": "package-version",
      "params": {
        "ecosystem": "PyPI",
        "name": "aiohttp",
        "ranges": [
          {
            "fixed": "3.14.4"
          }
        ]
      },
      "context": "any"
    }
  ],
  "remediation": [
    {
      "action": "Upgrade aiohttp",
      "details": "Use 3.14.4 or later. Prefer upgrading over switching parser implementations, because separate flaws affect each implementation.",
      "risk": "The release adds a default 1000-field form limit and changes parsing behavior; test legitimate forms and WebSocket traffic."
    }
  ],
  "verification": [
    "Confirm the loaded aiohttp package is 3.14.4 or later and restart dependent processes.",
    "Test legitimate compressed responses, WebSocket sessions, multipart uploads and forms."
  ],
