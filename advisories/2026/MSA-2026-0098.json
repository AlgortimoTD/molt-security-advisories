    "CVE-2026-128128",
    "CVE-2026-128127",
    "CVE-2026-128126",
    "CVE-2026-128124"
  ],
  "ghsa": [
    "GHSA-5rmc-48h2-hvcm",
    "GHSA-h4cc-hm5h-fmm9",
