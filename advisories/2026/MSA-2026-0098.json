{
  "schema": "msa/1",
  "id": "MSA-2026-0098",
  "title": "aiohttp HTTP and WebSocket parsing can exhaust resources and replay requests",
  "summary": "Small or compressed WebSocket messages can bypass receive-queue limits; concatenated compressed streams can exhaust CPU in clients and servers. Server flaws include unbounded buffering during upgrade handling, pure-Python request replay after a declined upgrade, integer overflow bypassing the C WebSocket message limit, base64 multipart size-limit bypass, excessive form fields and costly multi-wildcard domain matching.",
  "status": "published",
  "published": "2026-11-17",
  "updated": "2026-11-17",
  "cve": [
    "CVE-2026-128132",
    "CVE-2026-128131",
