{
  "schema": "msa/1",
  "id": "MSA-2026-0039",
  "title": "Incus and LXD project checks can be bypassed through copying and snapshot restore",
  "summary": "Missing source authorization permits copying instances or custom volumes from another project and accessing their secrets. Separately, restoring a crafted snapshot bypasses blocked low-level settings and can run host commands as root. The CVEs identify Incus; LXD uses separate GHSAs.",
  "status": "published",
  "published": "2026-11-07",
  "updated": "2026-11-07",
  "cve": [
    "CVE-2026-55622",
    "CVE-2026-55621",
    "CVE-2026-48751"
  ],
  "ghsa": [
    "GHSA-c9f5-j9c3-mhrg",
    "GHSA-64f3-v33m-w89f",
    "GHSA-48q5-w887-33wv",
    "GHSA-qx75-2p3r-pwm5",
    "GHSA-7mr3-28h5-m5vx",
    "GHSA-47w9-6r3f-938g"
  ],
  "severity": {
    "level": "high",
    "urgency": "72h",
    "rationale": "Restricted users can expose other projects' secrets or escape project execution restrictions. Existing API privileges and the specific copy or snapshot workflow are required, making this high priority for shared developer container services."
  },
  "vendor_severity": [
    {
      "source": "Incus",
      "value": "High",
      "applies_to": "Instance and custom-volume copy"
    },
    {
      "source": "Incus",
      "value": "9.9 Critical",
      "applies_to": "Snapshot restriction bypass"
    },
    {
