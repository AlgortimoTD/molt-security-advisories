      "applies_to": "LXD instance and custom-volume copy"
    },
    {
      "source": "GitHub Reviewed Advisory Database",
      "value": "9.9 Critical",
      "applies_to": "LXD snapshot restriction bypass"
    }
  ],
  "affected": [
    {
      "product": "Incus",
      "fixed": "7.2.0"
    },
    {
      "product": "github.com/canonical/lxd",
      "ecosystem": "Go",
      "fixed": "0.0.0-20260630083100-c5184be310b1",
      "note": "Go module revision, not a numbered LXD daemon release."
    }
  ],
  "exposure": "Copy attacks require destination creation rights and knowledge of the source project and object names on the same server. Snapshot attacks require transferring and restoring an instance snapshot containing blocked low-level settings.",
  "detectors": [
    {
      "type": "manual",
      "params": {
        "instructions": "Check Incus against 7.2.0 or a vendor backport. For LXD, verify the installed build contains all three project restriction fixes corresponding to Go revision c5184be310b1."
      },
      "context": "any"
    }
  ],
  "remediation": [
    {
      "action": "Apply the verified fix",
      "details": "Update Incus to 7.2.0 or later, or install an LXD vendor build containing all three listed project restriction fixes.",
      "risk": "Medium. Schedule service restarts and validate dependent workflows."
    }
  ],
  "verification": [
    "Confirm the running daemon contains the source authorization and snapshot restriction fixes; validate legitimate project workflows."
  ],
