{
  "schema": "msa/1",
  "id": "MSA-2026-0037",
  "title": "Incus and LXD image handling can redirect file operations onto the host",
  "summary": "Crafted images can redirect recorded command output or template and rootfs operations through symlinks. Crafted instance backups also expose the Incus templates flaw. A separate malicious image-server hash can redirect downloads outside image storage. These flaws permit host file access and possible command execution. The CVE identifiers here belong to the Incus advisories; LXD tracks corresponding flaws with separate GHSAs.",
  "status": "published",
  "published": "2026-11-07",
  "updated": "2026-11-07",
  "cve": [
    "CVE-2026-48750",
    "CVE-2026-48752",
    "CVE-2026-48749",
    "CVE-2026-48769"
  ],
  "ghsa": [
    "GHSA-73hr-m85f-64v9",
    "GHSA-vxp5-584q-c479",
    "GHSA-2q3f-q5pq-g8wv",
    "GHSA-f6m5-xw2g-xc4x",
    "GHSA-9j25-mm2h-2f76",
    "GHSA-jpf8-86f3-wp38",
    "GHSA-vghh-5rfx-xhq8",
    "GHSA-pjff-c2wc-f6jm"
  ],
  "severity": {
    "level": "high",
    "urgency": "72h",
    "rationale": "Host file operations cross the container boundary, risking credentials and code execution. Importing untrusted images or contacting a malicious image server, plus the relevant API operation, are meaningful preconditions in developer container environments."
  },
  "vendor_severity": [
    {
      "source": "Incus",
      "value": "9.9 Critical",
      "applies_to": "All four Incus image advisories"
    },
    {
      "source": "GitHub Reviewed Advisory Database",
      "value": "Critical",
      "applies_to": "All four LXD image advisories"
    }
  ],
  "affected": [
    {
      "product": "Incus",
      "fixed": "7.2.0",
      "note": "The four Incus advisories list versions before 7.2.0. Check vendor backports separately."
    },
    {
      "product": "github.com/canonical/lxd",
      "ecosystem": "Go",
      "fixed": "0.0.0-20260626085134-124f90100640",
      "note": "exec-output symlink flaw; Go module revision, not a numbered LXD daemon release."
    },
    {
      "product": "github.com/canonical/lxd",
      "ecosystem": "Go",
      "fixed": "0.0.0-20260203144152-d1c8ba15d160",
      "note": "templates symlink flaw; Go module revision."
    },
    {
      "product": "github.com/canonical/lxd",
      "ecosystem": "Go",
      "fixed": "0.0.0-20260630083100-c5184be310b1",
      "note": "rootfs symlink and trusted image hash flaws; Go module revision."
    }
  ],
  "exposure": "Requires importing a malicious image and invoking the affected operation, importing a crafted instance backup for the Incus templates flaw, or requesting a direct image download from a malicious server. The exec-output flaw also requires record-output; its created filenames are constrained.",
  "detectors": [
    {
      "type": "manual",
      "params": {
        "instructions": "Check Incus against 7.2.0 and vendor backports. For LXD, compare the installed build with the per-flaw Go revisions in affected and their vendor fixes; do not compare a daemon release number with a Go pseudo-version."
      },
      "context": "any"
    }
  ],
  "remediation": [
    {
      "action": "Apply the verified fix",
      "details": "Update Incus to 7.2.0 or a later patched release, or install an LXD vendor build containing the applicable listed fixes. Verify LXD backports against each linked advisory rather than assuming a numbered daemon release matches a Go pseudo-version.",
      "risk": "Medium. Schedule service restarts and validate dependent workflows."
    }
  ],
  "verification": [
    "Confirm the running daemon contains every applicable fix and validate trusted image and file operations."
  ],
